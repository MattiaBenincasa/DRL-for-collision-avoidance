<?xml version="1.0"?>
<!-- Sensor LIDAR modificato per avere campo visivo (FOV) di 270°
     (min_angle = -3*pi/4, max_angle = +3*pi/4) e samples=1080.
     Questa modifica è stata effettuata per conformare il sensore alle specifiche
     tecniche estratte da Feng et al. (2021) sulla prevenzione delle collisioni. -->
<robot name="storm_robot">

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.1"/></geometry> #robot dimensions: 40cm x 30cm x 10cm
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
    <collision> 
      <geometry><box size="0.4 0.3 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry> #laser sensor dimensions: radius 5cm, length 5cm
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.15 0 0.075" rpy="0 0 0"/> #laser mounted 15cm forward and 7.5cm above the base_link
  </joint>

  <gazebo>
    <plugin name="object_controller" filename="libgazebo_ros_planar_move.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>20.0</odometryRate>
      <robotBaseFrame>base_link</robotBaseFrame>
    </plugin>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor type="ray" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>512</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619449</min_angle>
            <max_angle>2.35619449</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
