<?xml version="1.0"?>
<launch>
  <arg name="world_file" default="$(find simulation_layer)/worlds/map_3.world" />
  <arg name="paused" default="false" />
  <arg name="use_sim_time" default="true" />
  <arg name="gui" default="true" />
  <arg name="headless" default="false" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
  </include>

  <param name="robot_description" command="cat $(find simulation_layer)/../storm.urdf" />
  <node name="spawn_storm" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file $(find simulation_layer)/../storm.urdf -urdf -model storm -x 0 -y 0 -z 0.05"/>

  <node name="robot_testing" pkg="simulation_layer" type="testing_paper.py" output="screen"/>
</launch>
